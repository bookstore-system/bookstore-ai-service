      "value": "00000000-0000-0000-0000-000000000001",
      "type": "string",
      "description": "UUID giả lập user — dùng cho các tool cần userId (recommendation, orderLookup)."
    },
    {
      "key": "sampleOrderId",
      "value": "00000000-0000-0000-0000-000000000abc",
      "type": "string",
      "description": "Mã đơn hàng mẫu để test orderLookupTool."
    }
  ],
  "item": [
    {
      "name": "01 - Chatbot (AI Agent)",
      "description": "Endpoint chat chính của service. Bên dưới là vòng lặp tool-calling: Gemini tự chọn tool (search, recommendation, order, multimodal, ...), agent thực thi tool rồi tổng hợp câu trả lời.\n\n**Response wrapper:** `{ code: 1000, message: \"Gửi tin nhắn thành công\", result: { response, sessionId, intent, toolCalls[] } }`.",
      "item": [
        {
          "name": "List Tools",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('ApiResponse success', () => {",
                  "    pm.expect(body.code).to.eql(200);",
                  "    pm.expect(body.message).to.eql('Success');",
                  "    pm.expect(body.result).to.be.an('array');",
                  "});",
                  "pm.test('Có ít nhất 1 tool và có field name/description/parameters', () => {",
                  "    pm.expect(body.result.length).to.be.above(0);",
                  "    const first = body.result[0];",
                  "    pm.expect(first).to.have.property('name');",
                  "    pm.expect(first).to.have.property('description');",
                  "    pm.expect(first).to.have.property('parameters');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/chatbot/tools",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "chatbot", "tools"]
            },
            "description": "Liệt kê metadata các tool agent đang bật. Verify ToolRegistry và cấu hình `ai.agent.enabled-tools`."
          },
          "response": []
        },
        {
          "name": "Chat - Search by Keyword (searchBooksTool)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('ApiResponse chatbot success', () => {",
                  "    pm.expect(body.code).to.eql(1000);",
                  "    pm.expect(body.message).to.eql('Gửi tin nhắn thành công');",
                  "    pm.expect(body.result).to.be.an('object');",
                  "});",
                  "pm.test('Agent response structure', () => {",
                  "    pm.expect(body.result.response).to.be.a('string').that.is.not.empty;",
                  "    pm.expect(body.result.sessionId).to.be.a('string').that.is.not.empty;",
                  "    pm.expect(body.result.intent).to.be.a('string');",
                  "    pm.expect(body.result.toolCalls).to.be.an('array');",
                  "});",
                  "pm.test('Agent đã gọi searchBooksTool (nếu Gemini hoạt động)', () => {",
                  "    const used = (body.result.toolCalls || []).map(t => t.toolName);",
                  "    if (body.result.intent !== 'CONFIG_ERROR' && body.result.intent !== 'OUT_OF_SCOPE') {",
                  "        pm.expect(used).to.include.oneOf(['searchBooksTool', 'semanticSearchTool']);",
                  "    }",
                  "});",
                  "if (body.result && body.result.sessionId) {",
                  "    pm.collectionVariables.set('sessionId', body.result.sessionId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Tìm cho tôi sách về Clean Code của Robert C. Martin\",\n  \"sessionId\": \"{{sessionId}}\",\n  \"userId\": \"{{userId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/chatbot/chat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "chatbot", "chat"]
            },
            "description": "Keyword rõ ràng → Gemini chọn `searchBooksTool` (hoặc fallback `semanticSearchTool`). Response phải kèm `toolCalls` chứa trace tool đã dùng — đây là dấu hiệu chứng minh chat đã là AI Agent thật sự."
          },
          "response": []
